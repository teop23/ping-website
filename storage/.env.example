# Copy to .env (gitignored) and fill in both values before `docker compose up -d`.

# Shared bearer token the storage service checks on every request but
# /healthz. Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value goes into the Pages secret CARD_STORE_TOKEN.
AUTH_TOKEN=

# From the Cloudflare Zero Trust dashboard: Networks > Tunnels > create a
# tunnel > "Docker" install method shows a command containing this token.
# See README.md for the full walkthrough.
TUNNEL_TOKEN=
